<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#0098E0"
                        android:endColor="#00537A"
                        android:angle="270" />
                </shape>
            </item>

            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="#FAFCFE" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>