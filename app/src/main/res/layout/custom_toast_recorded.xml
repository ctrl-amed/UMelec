<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/warning_toast_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/toast_background_base"
    android:maxWidth="400dp"
    android:layout_marginHorizontal="30dp"
    >



    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your vote has been recorded"
                android:textColor="#0E0E2C"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_semi_bold"
                android:layout_marginBottom="15dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vote ID: "
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/ReferenceCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Reference Code/HASH]"
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submitted On: "
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/ReferenceDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 28, 2025 at 10:20 PM"
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signature: "
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />

                <TextView
                    android:id="@+id/ReferenceSignature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[0xa8f2b1...]"
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This code is your proof of submission. It does not contain your ballot choices."
                android:textColor="#333333"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="15dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/content_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Download PDF"
            android:textColor="#0E0E2C"
            android:textSize="14sp"
            android:background="@drawable/yellow_rounded_button"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@animator/button_press_animator"
            android:paddingHorizontal="15dp"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_secondary"
            android:layout_width="wrap_content"
            android:paddingHorizontal="15dp"
            android:layout_height="40dp"
            android:layout_marginBottom="15dp"
            android:text="Send to Email"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:background="@drawable/blue_rounded_button"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_bold"
            android:stateListAnimator="@animator/button_press_animator"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>