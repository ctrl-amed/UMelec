<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. The Shadow/Accent Layer (F6BA68) -->
    <!-- This is the bottom layer. It occupies the full space. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6BA68"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- 2. The Main Content Layer (EEF2F5) -->
    <!-- We use an INSET (left margin) to push this shape to the right,
         revealing the bottom layer on the left. -->
    <item android:left="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#EEF2F5"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

</layer-list>
