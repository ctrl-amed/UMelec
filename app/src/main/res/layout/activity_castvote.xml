<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".Castvote">

    <!-- 1. Header Content (Fixed at the top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:contentDescription="back_button_content_description"
            android:src="@drawable/ic_arrow_back"
            android:stateListAnimator="@animator/button_press_animator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0098E0" />
        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Step 1 of 3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            android:layout_marginTop="30dp"/>

        <View
            android:id="@+id/progressBarBackground"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/progress_bar_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />
        <View
            android:id="@+id/progressBarFill"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_fill_gradient"
            app:layout_constraintBottom_toBottomOf="@id/progressBarBackground"
            app:layout_constraintStart_toStartOf="@id/progressBarBackground"
            app:layout_constraintTop_toTopOf="@id/progressBarBackground"
            app:layout_constraintWidth_percent="0.333" />
        <TextView
            android:id="@+id/stepCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Cast your vote"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBarBackground"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- 2. SCROLLABLE WHITE CONTAINER (Main Content) - Now constrained to the parent bottom -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="150dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/FooterButtonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp">

            <TextView
                    android:id="@+id/ElectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UMak Student Council \nElections 2025"
                android:textSize="24sp"
                android:textColor="#313131"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/montserrat_semi_bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select one candidate per position. Review carefully before submitting."
                android:textSize="12sp"
                android:textColor="#313131"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins_regular" />

            <!-- VOTING PROCESS CONTAINER -->
            <LinearLayout
                android:id="@+id/VotingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- The Position Card Template and the Required Warning Template below it -->
                <LinearLayout
                    android:id="@+id/PositionCardTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_gray_bg"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:translationZ="1dp"
                    android:outlineProvider="background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/PositionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Position:"
                            android:textSize="18sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="*"
                            android:textSize="16sp"
                            android:textColor="#FF0000"
                            android:gravity="end"
                            android:fontFamily="@font/montserrat_semi_bold"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDDDDD"
                        android:layout_marginBottom="12dp"/>

                    <!-- This RadioGroup is correctly emptied and populated in Castvote.kt -->
                    <RadioGroup
                        android:id="@+id/CandidateRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Example rows are left for reference, but are replaced by inflation in Castvote.kt -->
                        <LinearLayout
                            android:id="@+id/CandidateRow1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EEEEEE"/>
                    </RadioGroup>

                </LinearLayout>

                <!-- This is the required warning template that is copied and moved by Castvote.kt -->
                <LinearLayout
                    android:id="@+id/Required"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/reqText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Select or Abstain Required."
                        android:textColor="#D32F2F"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"/>

                </LinearLayout>

                <!-- THE SUBMIT BUTTON HAS BEEN MOVED OUT OF HERE -->

            </LinearLayout>
            <!-- END VOTING PROCESS CONTAINER -->

        </LinearLayout>
        <!-- END CONTENT CONTAINER -->
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/FooterButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_horizontal"
        android:elevation="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/blue_rounded_button"
            android:fontFamily="@font/poppins_bold"
            app:backgroundTint="@null"
            android:stateListAnimator="@animator/button_press_animator"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>